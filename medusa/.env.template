BACKEND_URL=http://localhost:9000
# Deployment label, separate from NODE_ENV (hosted dev also runs a production build).
APP_ENV=development
# Set to disable only for a private database connection without TLS (e.g. Render internal URLs).
DATABASE_SSL_MODE=
STOREFRONT_URL=http://localhost:8000
# Must match the storefront's STOREFRONT_REVALIDATE_SECRET
STOREFRONT_REVALIDATE_SECRET=supersecret
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:7000,http://localhost:7001
AUTH_CORS=http://localhost:7000,http://localhost:7001
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medusa
# Bachs payments. sk_sandbox_ keys use the sandbox API, sk_live_ keys use production.
# Webhook endpoint: {BACKEND_URL}/hooks/payment/bachs_bachs
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# minio
S3_FILE_URL=http://localhost:9090/medusa
S3_ACCESS_KEY_ID=medusaminio
S3_SECRET_ACCESS_KEY=medusaminio
S3_REGION=us-east-1
S3_BUCKET=medusa
S3_ENDPOINT=http://localhost:9090
S3_FORCE_PATH_STYLE=true

# resend
RESEND_API_KEY=
RESEND_FROM="Agilo <noreply@agilo.com>"

# meilisearch
MEILISEARCH_MASTER_KEY=yoursecretmasterkey
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=yoursecretmasterkey

# Better Stack error tracking (Sentry SDK DSN). Leave empty to disable.
SENTRY_DSN=

# DHL Express live shipping quotes. Keep this backend-only.
DHL_API_USERNAME=
DHL_API_PASSWORD=
DHL_ACCOUNT_NUMBER=
# Explicitly set live only after sandbox booking/cancellation acceptance checks.
DHL_ENVIRONMENT=sandbox
DHL_AUTO_BOOKING=false

# Shared server-only secret (same value in Medusa and storefront). Generate with openssl rand -hex 32.
# Required for checkout and guest receipt authorization; never prefix with NEXT_PUBLIC_.
RECEIPT_ACCESS_SECRET=
