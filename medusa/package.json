{
  "name": "fashion-starter-medusa",
  "version": "2.0.0",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "eslint src medusa-config.ts jest.config.ts instrumentation.ts eslint.config.mjs",
    "lint:fix": "eslint src medusa-config.ts jest.config.ts instrumentation.ts eslint.config.mjs --fix",
    "emails:dev": "email dev --dir=src/modules/resend/emails",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@agilo/medusa-analytics-plugin": "^1.4.0",
    "@medusajs/admin-sdk": "2.15.5",
    "@medusajs/cli": "2.15.5",
    "@medusajs/framework": "2.15.5",
    "@medusajs/icons": "2.15.5",
    "@medusajs/medusa": "2.15.5",
    "@medusajs/types": "2.15.5",
    "@medusajs/ui": "4.1.15",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-query": "5.100.14",
    "meilisearch": "0.58.0",
    "posthog-node": "^5.35.6",
    "react-dropzone": "^15.0.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@medusajs/test-utils": "2.15.5",
    "@react-email/preview-server": "^5.2.10",
    "@swc/core": "^1.15.40",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.4.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-email": "6.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.15.1"
}
